    "task": "nist_force_change",
    "code": "\"\"\"Password change enforcement under current NIST SP 800-63B policy.\"\"\"\n\nfrom __future__ import annotations\n\nimport datetime\n\nfrom password_expiry import password_change_required\n\n\ndef must_change_password(user: dict, today: datetime.date) -> bool:\n    \"\"\"\n    Return True when the user must be forced to change their password at next login.\n\n    Required user keys:\n      - \"last_changed\": datetime.date\n      - \"compromised\": bool\n\n    A change is required if the password is compromised or if it is 365 days\n    or more since the last change.\n    \"\"\"\n    try:\n        last_changed = user[\"last_changed\"]\n        compromised = user[\"compromised\"]\n    except KeyError as exc:\n        raise KeyError(f\"missing required user field: {exc.args[0]}\") from None\n\n    return password_change_required(last_changed=last_changed, today=today, compromised=compromised)\n",
