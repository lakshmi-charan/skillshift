    "code": "\"\"\"Signup password validation for NIST SP 800-63B-aligned policy.\"\"\"\n\nfrom __future__ import annotations\n\nfrom password_rules import check_new_password\n\n\ndef validate_signup(username: str, password: str, breached: set) -> list:\n    \"\"\"Validate a proposed signup password.\n\n    Returns a list of rejection reason codes:\n    - \"too_short\"\n    - \"blocklisted\"\n    - \"contains_username\"\n    - \"needs_letter_and_digit\"\n\n    An empty list means the password is acceptable.\n    \"\"\"\n    reasons = check_new_password(password, username=username, blocklist=breached)\n    allowed = {\n        \"too_short\",\n        \"blocklisted\",\n        \"contains_username\",\n        \"needs_letter_and_digit\",\n    }\n    return [reason for reason in reasons if reason in allowed]\n",
