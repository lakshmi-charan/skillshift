    "code": "\"\"\"Login guard for consecutive failed password attempts per account.\"\"\"\n\nfrom login_throttle import Throttle\n\n\nclass LoginGuard:\n    \"\"\"Track consecutive failed password attempts and lock accounts at the limit.\"\"\"\n\n    def __init__(self):\n        self._throttle = Throttle()\n\n    def failed(self, account: str):\n        \"\"\"Record a failed authentication attempt for the given account.\"\"\"\n        self._throttle.record_failure(account)\n\n    def succeeded(self, account: str):\n        \"\"\"Record a successful authentication attempt for the given account.\"\"\"\n        self._throttle.record_success(account)\n\n    def locked(self, account: str) -> bool:\n        \"\"\"Return True if the account is locked due to consecutive failures.\"\"\"\n        return self._throttle.is_locked(account)\n",
