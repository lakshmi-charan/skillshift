   {
    "task": "nist_lockout",
    "code": "\"\"\"login_guard\n\nConsecutive-failure tracking for password authentication.\n\nImplements the organisation's account-throttling rule:\n- An account is locked once it reaches 100 consecutive failed attempts.\n- A successful authentication resets the consecutive-failure count.\n\"\"\"\n\nfrom __future__ import annotations\n\n\nclass LoginGuard:\n    \"\"\"Track consecutive failed password attempts per account.\"\"\"\n\n    _LOCKOUT_LIMIT = 100\n\n    def __init__(self):\n        self._failures: dict[str, int] = {}\n        self._locked: set[str] = set()\n\n    def failed(self, account: str):\n        \"\"\"Record a failed authentication attempt for *account*.\"\"\"\n        count = self._failures.get(account, 0) + 1\n        self._failures[account] = count\n        if count >= self._LOCKOUT_LIMIT:\n            self._locked.add(account)\n\n    def succeeded(self, account: str):\n        \"\"\"Record a successful authentication for *account*.\"\"\"\n        self._failures[account] = 0\n        self._locked.discard(account)\n\n    def locked(self, account: str) -> bool:\n        \"\"\"Return True if *account* is currently locked.\"\"\"\n        return account in self._locked\n",
