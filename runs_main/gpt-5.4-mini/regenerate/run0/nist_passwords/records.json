    "code": "from __future__ import annotations\n\nimport datetime as _datetime\n\nfrom password_expiry import password_change_required\n\n\ndef must_change_password(user: dict, today: _datetime.date) -> bool:\n    \"\"\"\n    Return True when the user must be forced to change their password at next login.\n\n    Under the current rules, a password change is required only when there is\n    evidence the password was compromised. Periodic expiry is not enforced.\n    \"\"\"\n    if not isinstance(user, dict):\n        raise TypeError(\"user must be a dict\")\n    if not isinstance(today, _datetime.date):\n        raise TypeError(\"today must be a datetime.date\")\n\n    try:\n        last_changed = user[\"last_changed\"]\n        compromised = user[\"compromised\"]\n    except KeyError as e:\n        raise KeyError(f\"missing required user field: {e.args[0]}\") from e\n\n    if not isinstance(last_changed, _datetime.date):\n        raise TypeError(\"user['last_changed'] must be a datetime.date\")\n    if not isinstance(compromised, bool):\n        raise TypeError(\"user['compromised'] must be a bool\")\n\n    return password_change_required(last_changed, today, compromised=compromised)\n",
