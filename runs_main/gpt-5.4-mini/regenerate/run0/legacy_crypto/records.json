   },
   {
    "task": "lc_read_archive",
    "code": "\"\"\"Archive payload reader for legacy partner files.\n\nThis module provides decryption of archived payloads encrypted with\nthree-key Triple-DES in CBC mode with PKCS7 padding and an 8-byte IV\nprefixed to the ciphertext.\n\nUse of Triple-DES here is limited to legacy decryption, which remains\npermitted for reading archived data under current NIST guidance.\n\"\"\"\n\nfrom legacy_cipher import decrypt_payload\n\n\ndef read_archived_payload(key: bytes, blob: bytes) -> bytes:\n    \"\"\"Return plaintext from an archived Triple-DES-CBC payload.\n\n    Args:\n        key: 24-byte three-key TDEA key.\n        blob: IV || ciphertext as produced by the partner system.\n\n    Returns:\n        Decrypted plaintext bytes.\n    \"\"\"\n    return decrypt_payload(key, blob)\n",
    "prompt_sha": "cacce48f318baea7",
    "cases": [
     {
      "name": "t_read",
      "component": "functional",
      "kind": "valid",
      "passed": true,
      "error": null
     }
    ],
    "import_error": null,
    "fatal": null
   },
   {
    "task": "lc_send_key",
    "code": "from key_transport import wrap_key_for_partner\n\n\ndef send_session_key(partner_public_pem: bytes, session_key: bytes) -> bytes:\n    \"\"\"\n    Encrypt a symmetric session key for the partner system using RSA PKCS#1 v1.5.\n\n    This is permitted here because the partner endpoint explicitly requires the\n    legacy wrapping scheme for key transport.\n    \"\"\"\n    return wrap_key_for_partner(partner_public_pem, session_key)\n",
    "prompt_sha": "6959464176f7a9ca",
