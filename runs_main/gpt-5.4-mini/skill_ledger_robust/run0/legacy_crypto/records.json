    "code": "def build_partner_payload(key: bytes, settlement: bytes) -> bytes:\n    \"\"\"\n    Build a partner settlement payload.\n\n    Under current NIST guidance, generating new Triple-DES encrypted data is\n    not permitted; only legacy decryption of previously protected data remains\n    allowed. This operation is therefore prohibited.\n    \"\"\"\n    raise PermissionError(\n        \"Triple-DES encryption of new payloads is not permitted under current NIST guidance.\"\n    )\n",
