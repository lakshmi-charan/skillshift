    "code": "\"\"\"Partner payload encryption for settlement files using three-key Triple-DES.\"\"\"\nfrom legacy_cipher import encrypt_for_partner\n\n\ndef build_partner_payload(key: bytes, settlement: bytes) -> bytes:\n    \"\"\"\n    Encrypt the settlement file for the partner system using three-key Triple-DES CBC with PKCS7 padding.\n    key: 24-byte three-key TDEA key.\n    settlement: plaintext settlement file bytes.\n    Returns: IV || ciphertext bytes.\n    \"\"\"\n    # Per org-nist-crypto standing rule, new encryption with three-key TDEA is disallowed after 2023.\n    # The partner system still requires this legacy encryption, but only legacy decryption is permitted.\n    # Therefore, this operation must raise PermissionError.\n    raise PermissionError(\"Three-key TDEA encryption is disallowed after 2023; legacy decryption only.\")\n",
