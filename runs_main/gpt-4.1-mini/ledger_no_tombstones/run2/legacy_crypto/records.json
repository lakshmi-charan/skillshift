    "code": "\"\"\"Read archived payloads encrypted with three-key Triple-DES in CBC mode (PKCS7 padding, 8-byte IV prepended).\"\"\"\n\nfrom legacy_cipher import decrypt_payload\n\n\ndef read_archived_payload(key: bytes, blob: bytes) -> bytes:\n    \"\"\"\n    Decrypt a partner system archived payload encrypted with three-key Triple-DES in CBC mode.\n\n    Args:\n        key (bytes): 24-byte Triple-DES key (three-key TDEA).\n        blob (bytes): The encrypted payload, IV (8 bytes) prepended.\n\n    Returns:\n        bytes: The decrypted plaintext.\n    \"\"\"\n    return decrypt_payload(key, blob)\n",
