    "code": "\"\"\"Key exchange for partner system using RSA PKCS#1 v1.5 wrapping.\"\"\"\nfrom key_transport import wrap_key_for_partner\n\n\ndef send_session_key(partner_public_pem: bytes, session_key: bytes) -> bytes:\n    \"\"\"\n    Wrap the session key under the partner's RSA public key using PKCS#1 v1.5 padding.\n\n    Args:\n        partner_public_pem: PEM-encoded RSA public key of the partner.\n        session_key: Symmetric session key bytes to wrap.\n\n    Returns:\n        Encrypted session key bytes to send to the partner.\n    \"\"\"\n    return wrap_key_for_partner(partner_public_pem, session_key)\n",
