   {
    "task": "nist_signup_check",
    "code": "\"\"\"Password validation for sign-up under NIST SP 800-63B-4 and organisation rules.\"\"\"\n\nimport password_rules\n\n\ndef validate_signup(username: str, password: str, breached: set) -> list:\n    \"\"\"\n    Validate a new password for sign-up.\n\n    Args:\n        username: The username string.\n        password: The proposed password string.\n        breached: A set of known-compromised passwords (blocklist).\n\n    Returns:\n        A list of rejection reasons:\n        - \"too_short\"\n        - \"blocklisted\"\n        - \"contains_username\"\n        - \"needs_letter_and_digit\"\n        Empty list if password is acceptable.\n    \"\"\"\n    # Use the organisation's password_rules checker with the breached set as blocklist\n    # The password_rules.check_new_password returns all reasons including organisation rules\n    reasons = password_rules.check_new_password(password, username=username, blocklist=breached)\n\n    # According to NIST SP 800-63B-4, composition rules are not allowed,\n    # but organisation rules apply only where they do not conflict with mandatory requirements.\n    # The organisation rule \"needs_letter_and_digit\" is not allowed by NIST (composition rules disallowed),\n    # so it must be removed if present.\n\n    # Remove \"needs_letter_and_digit\" if present to comply with NIST mandatory SHALL NOT impose composition rules\n    if \"needs_letter_and_digit\" in reasons:\n        reasons.remove(\"needs_letter_and_digit\")\n\n    # Enforce minimum length of 15 characters for single-factor authentication passwords per NIST\n    # Our organisation rule minimum length is 8, but NIST requires 15 for single-factor\n    # So override if password is shorter than 15 characters\n    if len(password) < 15:\n        if \"too_short\" not in reasons:\n            reasons.append(\"too_short\")\n\n    # The organisation rule \"contains_username\" rejects passwords containing username substring,\n    # NIST mandates blocklist includes username exact and derivatives, but does not forbid substring rejection.\n    # Organisation rule applies only where not conflicting, and NIST requires blocklist to include username and derivatives.\n    # So \"contains_username\" reason is acceptable.\n\n    # Return the final list of reasons\n    return reasons\n",
