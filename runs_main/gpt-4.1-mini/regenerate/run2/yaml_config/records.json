    "code": "from config_loader import load_config_text\n\ndef service_port(config_text: str) -> int:\n    \"\"\"\n    Parse YAML configuration text and return the integer at service.port.\n    Raise KeyError if 'service' or 'port' keys are missing.\n    Raise ValueError if top-level YAML document is not a mapping.\n    \"\"\"\n    config = load_config_text(config_text)\n    service = config[\"service\"]  # May raise KeyError\n    port = service[\"port\"]       # May raise KeyError\n    return port\n",
