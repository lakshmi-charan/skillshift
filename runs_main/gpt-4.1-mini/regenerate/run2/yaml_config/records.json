   {
    "task": "yaml_env_dsn",
    "code": "import yaml\n\nclass EnvLoader(yaml.SafeLoader):\n    pass\n\ndef env_constructor(loader, node):\n    value = loader.construct_scalar(node)\n    if ':' in value:\n        name, default = value.split(':', 1)\n    else:\n        name, default = value, None\n    env = loader.env\n    if name in env:\n        return env[name]\n    if default is not None:\n        return default\n    return None\n\nEnvLoader.add_constructor('!env', env_constructor)\n\ndef build_dsn(config_text: str, env: dict) -> str:\n    \"\"\"\n    Load YAML config_text with !env substitutions from env dict,\n    then build and return the DSN string:\n    \"postgresql://<user>:<password>@<host>:<port>/<name>\"\n    \"\"\"\n    # Attach env dict to loader class instance for access in constructor\n    loader = EnvLoader\n    loader.env = env\n    config = yaml.load(config_text, Loader=loader)\n    if config is None:\n        raise ValueError(\"Empty config\")\n    if not isinstance(config, dict):\n        raise ValueError(\"Top-level YAML document must be a mapping\")\n    if 'database' not in config:\n        raise ValueError(\"Missing 'database' section in config\")\n    db = config['database']\n    if not isinstance(db, dict):\n        raise ValueError(\"'database' section must be a mapping\")\n    # Extract required keys\n    try:\n        host = db['host']\n        port = db['port']\n        name = db['name']\n        user = db['user']\n        password = db['password']\n    except KeyError as e:\n        raise ValueError(f\"Missing database key: {e.args[0]}\")\n\n    # Compose DSN string\n    return f\"postgresql://{user}:{password}@{host}:{port}/{name}\"\n",
