    "task": "yaml_env_dsn",
    "code": "\"\"\"Build a PostgreSQL DSN from YAML config text with !env substitutions.\"\"\"\nimport env_tags\n\n\ndef build_dsn(config_text: str, env: dict) -> str:\n    \"\"\"Return a PostgreSQL DSN from YAML config with !env substitutions.\"\"\"\n    config = env_tags.load_with_env(config_text, env)\n    db = config.get(\"database\", {})\n    user = db[\"user\"]\n    password = db[\"password\"]\n    host = db[\"host\"]\n    port = db[\"port\"]\n    name = db[\"name\"]\n    return f\"postgresql://{user}:{password}@{host}:{port}/{name}\"\n",
