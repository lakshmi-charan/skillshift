    "task": "yaml_service_port",
    "code": "import yaml\n\n\ndef service_port(config_text: str) -> int:\n    \"\"\"Parse YAML config_text and return the integer at service.port.\n\n    Raises KeyError if 'service' or 'port' keys are missing.\n    Raises ValueError if the top-level YAML document is not a mapping.\n    \"\"\"\n    data = yaml.safe_load(config_text)\n    if data is None:\n        raise KeyError(\"Missing 'service' key\")\n    if not isinstance(data, dict):\n        raise ValueError(\"configuration must be a mapping at the top level\")\n    service = data[\"service\"]  # May raise KeyError\n    port = service[\"port\"]  # May raise KeyError\n    if not isinstance(port, int):\n        raise ValueError(\"service.port must be an integer\")\n    return port\n",
