   {
    "task": "nist_signup_check",
    "code": "\"\"\"Sign-up password validation under current NIST SP 800-63B and organisation rules.\"\"\"\n\nimport password_rules\n\n\ndef validate_signup(username: str, password: str, breached: set) -> list:\n    \"\"\"\n    Validate a new password for sign-up.\n\n    Args:\n        username: The username to check against.\n        password: The proposed password.\n        breached: A set of known-compromised passwords.\n\n    Returns:\n        A list of rejection reasons:\n        - \"too_short\"\n        - \"blocklisted\"\n        - \"contains_username\"\n        - \"needs_letter_and_digit\"\n        Empty list means the password is accepted.\n    \"\"\"\n    reasons = []\n\n    # Check minimum length and max length per NIST SP 800-63B and organisation rules\n    if len(password) < password_rules.MIN_LENGTH:\n        reasons.append(\"too_short\")\n    if len(password) > password_rules.MAX_LENGTH:\n        # The spec does not request a reason for too_long, so we do not add it.\n        # We silently reject by returning reasons if any.\n        # But since the request does not specify \"too_long\", we skip adding it.\n        # The password_rules module does not add \"too_long\" in check_new_password either.\n        # So no reason added here.\n        return reasons  # Immediately reject if too long\n\n    # Check if password is blocklisted or breached\n    # The blocklist check is case-sensitive exact match\n    if password in breached:\n        reasons.append(\"blocklisted\")\n\n    # Check if password contains username (case-insensitive)\n    # Organisation rule: reject if password contains username anywhere\n    if username and username.lower() in password.lower():\n        reasons.append(\"contains_username\")\n\n    # Check composition: must contain at least one letter and one digit\n    # Organisation rule\n    has_letter = any(c.isalpha() for c in password)\n    has_digit = any(c.isdigit() for c in password)\n    if not (has_letter and has_digit):\n        reasons.append(\"needs_letter_and_digit\")\n\n    return reasons\n",
