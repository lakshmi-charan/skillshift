   {
    "task": "nist_signup_check",
    "code": "\"\"\"Signup password validation under current NIST SP 800-63B and organisation rules.\"\"\"\n\nimport password_rules\n\n\ndef validate_signup(username: str, password: str, breached: set) -> list:\n    \"\"\"\n    Validate a new signup password against current rules.\n\n    Args:\n        username: The username string.\n        password: The proposed password string.\n        breached: A set of known-compromised passwords (blocklist).\n\n    Returns:\n        A list of rejection reasons. Empty list means password is accepted.\n        Possible reasons: \"too_short\", \"blocklisted\", \"contains_username\", \"needs_letter_and_digit\".\n    \"\"\"\n    # Use password_rules.check_new_password but exclude organisation rules that conflict with current revision:\n    # Remove username_substring and composition checks as they conflict with current revision.\n    # We keep min_length, blocklist, and username_exact checks.\n    reasons = []\n\n    # Check min_length and max_length (max_length rejection not requested to report)\n    if len(password) < password_rules.MIN_LENGTH:\n        reasons.append(\"too_short\")\n\n    # Check blocklist: breached passwords\n    if password in breached:\n        reasons.append(\"blocklisted\")\n\n    # Check blocklist: password_rules blocklist (if any)\n    # The problem statement says breached is the blocklist to check.\n    # So no separate blocklist argument is given to check_new_password.\n    # We do not use password_rules.blocklist here because it requires a blocklist argument.\n\n    # Check username exact match (case-insensitive)\n    if username and username.lower() == password.lower():\n        reasons.append(\"contains_username\")\n\n    # The organisation rules for username substring and composition are retired because they conflict with current revision.\n    # So do not check for \"needs_letter_and_digit\" or \"contains_username\" as substring.\n\n    return reasons\n",
