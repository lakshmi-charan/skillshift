    "code": "\"\"\"LoginGuard for consecutive-failure throttling per account.\"\"\"\n\nfrom login_throttle import Throttle\n\n\nclass LoginGuard:\n    def __init__(self):\n        self._throttle = Throttle()\n\n    def failed(self, account: str):\n        \"\"\"Record a failed authentication attempt for the account.\"\"\"\n        self._throttle.record_failure(account)\n\n    def succeeded(self, account: str):\n        \"\"\"Record a successful authentication attempt for the account.\"\"\"\n        self._throttle.record_success(account)\n\n    def locked(self, account: str) -> bool:\n        \"\"\"Return True if the account is locked due to too many consecutive failures.\"\"\"\n        return self._throttle.is_locked(account)\n",
