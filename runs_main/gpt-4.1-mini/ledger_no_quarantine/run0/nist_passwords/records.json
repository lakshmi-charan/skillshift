   {
    "task": "nist_signup_check",
    "code": "\"\"\"Sign-up password validation under current NIST SP 800-63B rules and organisation policy.\"\"\"\n\nfrom password_rules import check_new_password\n\n\ndef validate_signup(username: str, password: str, breached: set) -> list:\n    \"\"\"\n    Validate a new password for sign-up.\n\n    Args:\n        username: The username string.\n        password: The proposed password string.\n        breached: A set of known-compromised passwords (blocklist).\n\n    Returns:\n        A list of rejection reasons. Empty list means the password is acceptable.\n        Possible reasons: \"too_short\", \"blocklisted\", \"contains_username\", \"needs_letter_and_digit\".\n    \"\"\"\n    # Use the password_rules check_new_password with the breached set as blocklist\n    reasons = check_new_password(password, username=username, blocklist=breached)\n\n    # Remove any reasons not in the allowed set (should not occur, but to be safe)\n    allowed_reasons = {\"too_short\", \"blocklisted\", \"contains_username\", \"needs_letter_and_digit\"}\n    filtered_reasons = [r for r in reasons if r in allowed_reasons]\n\n    return filtered_reasons\n",
