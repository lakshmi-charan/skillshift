    "code": "from legacy_cipher import encrypt_for_partner\n\n\ndef build_partner_payload(key: bytes, settlement: bytes) -> bytes:\n    # Three-key TDEA encryption is disallowed after 2023 by NIST SP 800-131A Rev. 2.\n    # The partner system requires this legacy encryption, but our policy forbids new encryption.\n    # Therefore, raise PermissionError to comply with org-nist-crypto standing rule.\n    raise PermissionError(\"Three-key TDEA encryption is disallowed after 2023 by NIST SP 800-131A Rev. 2.\")\n",
