    "code": "\"\"\"Key transport for partner system with legacy RSA PKCS#1 v1.5 padding.\"\"\"\n\nfrom key_transport import wrap_key_for_partner\n\n\ndef send_session_key(partner_public_pem: bytes, session_key: bytes) -> bytes:\n    \"\"\"\n    Wrap the session key using the partner's RSA public key with PKCS#1 v1.5 padding.\n\n    This operation is legacy and only permitted for decrypting or verifying old data as per NIST guidance.\n    Since this is sending (encrypting) a session key for the partner, it is disallowed.\n\n    Raises:\n        PermissionError: Because RSA PKCS#1 v1.5 padding for key transport is disallowed after 2023.\n    \"\"\"\n    # According to org-nist-crypto standing rule and key_transport module,\n    # RSA PKCS#1 v1.5 wrapping for key transport is disallowed after 2023.\n    # So we must raise PermissionError here.\n    raise PermissionError(\"RSA PKCS#1 v1.5 padding for key transport is disallowed after 2023 by NIST SP 800-131A Rev. 2.\")\n",
