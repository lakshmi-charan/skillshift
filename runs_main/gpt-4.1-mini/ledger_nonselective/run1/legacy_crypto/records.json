    "code": "\"\"\"Key transport for partner system using RSA PKCS#1 v1.5 wrapping.\"\"\"\n\nfrom key_transport import wrap_key_for_partner\n\n\ndef send_session_key(partner_public_pem: bytes, session_key: bytes) -> bytes:\n    \"\"\"\n    Wrap the session key under the partner's RSA public key using PKCS#1 v1.5 padding.\n\n    This operation is disallowed after 2023 by NIST guidance, so raise PermissionError.\n    \"\"\"\n    # The partner system only accepts RSA PKCS#1 v1.5 wrapped keys, but this is disallowed after 2023\n    raise PermissionError(\"RSA PKCS#1 v1.5 key transport is disallowed after 2023\")\n",
