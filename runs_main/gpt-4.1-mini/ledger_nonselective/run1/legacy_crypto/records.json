    "code": "\"\"\"Send session key encrypted for partner with RSA PKCS#1 v1.5 padding.\"\"\"\n\nfrom key_transport import wrap_key_for_partner\n\n\ndef send_session_key(partner_public_pem: bytes, session_key: bytes) -> bytes:\n    \"\"\"\n    Encrypt the session key under the partner's RSA public key using PKCS#1 v1.5 padding.\n\n    Raises PermissionError because RSA PKCS#1 v1.5 key transport is disallowed after 2023 by NIST SP 800-131A Rev. 2.\n    \"\"\"\n    # The partner system only accepts RSA PKCS#1 v1.5 wrapped keys,\n    # but this is disallowed by current NIST guidance.\n    # According to org-nist-crypto standing rule, raise PermissionError.\n    raise PermissionError(\"RSA PKCS#1 v1.5 key transport is disallowed after 2023 by NIST SP 800-131A Rev. 2\")\n",
