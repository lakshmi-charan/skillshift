    "code": "\"\"\"Build partner payload with three-key Triple-DES encryption (legacy allowed for partner).\"\"\"\nfrom legacy_cipher import tdes_encrypt\n\n\ndef build_partner_payload(key: bytes, settlement: bytes) -> bytes:\n    \"\"\"\n    Encrypt the settlement file for the partner system using three-key Triple-DES in CBC mode\n    with PKCS7 padding and 8-byte IV prepended.\n\n    Args:\n        key (bytes): 24-byte three-key TDEA key.\n        settlement (bytes): plaintext settlement file data.\n\n    Returns:\n        bytes: IV || ciphertext encrypted for the partner.\n\n    Raises:\n        PermissionError: if encryption is disallowed by current NIST guidance.\n    \"\"\"\n    # Use legacy_cipher.tdes_encrypt which raises PermissionError if disallowed.\n    return tdes_encrypt(key, settlement)\n",
