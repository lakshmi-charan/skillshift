    "code": "from legacy_cipher import encrypt_for_partner\n\n\ndef build_partner_payload(key: bytes, settlement: bytes) -> bytes:\n    # Encryption with three-key TDEA is disallowed after 2023 by NIST SP 800-131A Rev. 2\n    # The partner system still requires this legacy encryption, so allow only legacy use.\n    # However, the legacy_cipher.encrypt_for_partner raises PermissionError to enforce policy.\n    # According to the standing rule, operations allowed only for legacy use remain permitted.\n    # Here, since this is encryption, which is disallowed for new data, we must raise PermissionError.\n    raise PermissionError(\"Three-key TDEA encryption disallowed after 2023 by NIST SP 800-131A Rev. 2\")\n",
